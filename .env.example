# PostgreSQL 数据库用户
DB_USERNAME=karisanki
# PostgreSQL 数据库密码，部署前请修改
DB_PASSWORD=change-me
# 逗号分隔的注册邀请码，为空时注册保持关闭
KARISANKI_INVITE_CODES=change-me
# 是否开放注册，true 为开放，false 为关闭
KARISANKI_REGISTRATION_ENABLED=true
# 登录/注册限流：窗口内最大尝试次数
KARISANKI_RATE_LIMIT_MAX_ATTEMPTS=10
# 登录/注册限流窗口，例如 10m 或 1h
KARISANKI_RATE_LIMIT_WINDOW=10m
# 通过 HTTPS 提供服务时设为 true
COOKIE_SECURE=false
# 前端宿主机端口
PORT=3000

# 后端测试数据库连接，仅本地运行测试时需要
TEST_DB_URL=jdbc:postgresql://localhost:5433/karisanki_test
# 后端测试数据库用户
TEST_DB_USERNAME=karisanki
# 后端测试数据库密码
TEST_DB_PASSWORD=karisanki
